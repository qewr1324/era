{
	"name": "era",
	"type": "module",
	"displayName": "Elastic Ready Automation",
	"description": "🧊 Elastic Ready Automation - Visual workflow builder for Node.js — design automation in VS Code, export to executable JavaScript, run anywhere for 💠 VSCode. ",
	"version": "1.39.29",
	"private": false,
	"publisher": "GhurbeSABZI",
	"packageManager": "bun@1.3.14",
	"author": "GhurbeSABZI <naiad.arts.studio@gmail.com>",
	"icon": "res/era-icon-big.png",
	"license": "MIT",
	"homepage": "https://github.com/qewr1324/era#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/qewr1324/era"
	},
	"bugs": {
		"url": "https://github.com/qewr1324/era/issues"
	},
	"engines": {
		"vscode": "^1.85.0"
	},
	"keywords": [
		"automation",
		"workflow",
		"visual-builder",
		"code-generator",
		"nodejs",
		"low-code",
		"vscode-extension",
		"era",
		"elastic-ready-automation"
	],
	"categories": [
		"Programming Languages",
		"Other"
	],
	"galleryBanner": {
		"color": "#0F1A1C",
		"theme": "dark"
	},
	"preview": false,
	"qna": "marketplace",
	"activationEvents": [
		"onStartupFinished",
		"onCustomEditor:era.editor"
	],
	"main": "./dist/extension.cjs",
	"contributes": {
		"commands": [
			{
				"command": "era.createFlow",
				"title": "ERA: Create New Flow"
			},
			{
				"command": "era.exportBundle",
				"title": "ERA: Export Flow Bundle"
			},
			{
				"command": "era.runFlow",
				"title": "ERA: Run Flow"
			},
			{
				"command": "era.validateFlow",
				"title": "ERA: Validate Flow"
			}
		],
		"customEditors": [
			{
				"viewType": "era.editor",
				"displayName": "ERA Flow Editor",
				"selector": [
					{
						"filenamePattern": "*.era.json"
					}
				]
			}
		],
		"keybindings": [
			{
				"command": "era.runFlow",
				"key": "ctrl+shift+r",
				"when": "editorLangId == json && resourceFilename =~ /\\.era\\.json$/"
			},
			{
				"command": "era.validateFlow",
				"key": "ctrl+shift+v",
				"when": "editorLangId == json && resourceFilename =~ /\\.era\\.json$/"
			}
		]
	},
	"scripts": {
		"-----------builds-----------": "",
		"vscode:prepublish": "bun run build",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"dev": "bun run build --watch --sourcemap",
		"prepare": "echo 'Skipping update'",
		"update": "echo 'Skipping vscode-ext-gen'",
		"lint": "eslint .",
		"test": "vitest",
		"typecheck": "tsc --noEmit",
		"release": "bumpp",
		"ext:package": "vsce package --no-dependencies",
		"ext:publish": "vsce publish --no-dependencies",
		"-----------new-build-----------": "",
		"build": "bun run build:ext && bun run build:webview",
		"build:ext": "tsdown src/extension.ts --external vscode",
		"-----------webviews-----------": "",
		"build:webview": "node scripts/build-webview.mjs",
		"dev:webview": "node scripts/build-webview.mjs --watch"
	},
	"devDependencies": {
		"@types/vscode": "^1.85.0",
		"@types/node": "^20.0.0",
		"typescript": "^5.3.0",
		"@antfu/eslint-config": "^6.7.3",
		"@antfu/ni": "^28.0.0",
		"@vscode/vsce": "^3.7.1",
		"bumpp": "^10.3.2",
		"eslint": "^9.39.2",
		"ovsx": "^0.10.7",
		"reactive-vscode": "^1.0.0-beta.2",
		"taze": "^19.9.2",
		"tsdown": "^0.19.0-beta.3",
		"vite": "^7.3.0",
		"vitest": "^4.0.16",
		"vscode-ext-gen": "^1.5.1",
		"vsxpub": "^0.1.2"
	}
}
